name: fetch-seed-curves

on:
  schedule:
    # UTC 04:00 周日 = 北京时间 12:00 周日
    # 刻意排在日报（08:50）之后 3 小时，避开 Google 的 IP 级限流
    - cron: "0 4 * * 0"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  seed:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      # 常青种子词：不看"今天什么爆了"，看"哪个需求在悄悄抬头"
      - name: Fetch seed keyword curves
        shell: bash
        run: |
          python - <<'PY'
          import csv, json, os, random, sys, time
          import urllib.parse, urllib.request
          from datetime import datetime, timezone, timedelta

          BASE = "https://trends.google.com/trends/api"
          TZ = "-480"
          BJ = timezone(timedelta(hours=8))
          GEO = "US"
          TF = "now 7-d"
          # 要改就改这里：常年有人搜、工具属性强的词。曲线平稳是常态，抬头才是信号
          KEYWORDS = [
              "ai resume",
              "pdf converter",
              "remove background",
              "youtube transcript",
              "logo maker",
          ]
          UA = {
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
              "Accept": "application/json, text/plain, */*",
              "Accept-Language": "en-US,en;q=0.9",
              "Referer": "https://trends.google.com/",
              "Origin": "https://trends.google.com",
          }
          LOG = []
          STATE = {"quota": 0}

          def say(m):
              print(m, flush=True)
              LOG.append(str(m))

          def http(url, params):
              qs = urllib.parse.urlencode(params)
              try:
                  req = urllib.request.Request(url + "?" + qs, headers=UA)
                  with urllib.request.urlopen(req, timeout=30) as r:
                      raw = r.read().decode("utf-8", "ignore")
                  return json.loads(raw[raw.find("{"):])
              except Exception as e:
                  msg = str(e)
                  if "429" in msg:
                      STATE["quota"] += 1
                      say("  429 限流（第 %d 次），放弃该请求" % STATE["quota"])
                      return None
                  say("  请求失败: %s" % msg[:120])
                  return None

          def curve(kw):
              payload = {"comparisonItem": [{"keyword": kw, "geo": GEO, "time": TF}], "category": 0, "property": ""}
              ex = http(BASE + "/explore",
                        {"hl": "en-US", "tz": TZ, "req": json.dumps(payload, separators=(",", ":"))})
              if not ex:
                  return []
              w = next((x for x in ex.get("widgets", []) if x.get("id") == "TIMESERIES"), None)
              if not w:
                  return []
              d = http(BASE + "/widgetdata/multiline",
                       {"hl": "en-US", "tz": TZ,
                        "req": json.dumps(w["request"], separators=(",", ":")),
                        "token": w["token"]})
              if not d:
                  return []
              pts = []
              for p in d.get("default", {}).get("timelineData", []):
                  hd = p.get("hasData")
                  if hd and not any(hd):
                      continue
                  v = (p.get("value") or [None])[0]
                  ts = p.get("time")
                  if v is None or not ts:
                      continue
                  day = datetime.fromtimestamp(int(ts), tz=timezone.utc).astimezone(BJ).strftime("%Y-%m-%d")
                  pts.append((day, int(v)))
              return pts

          os.makedirs("data/seed", exist_ok=True)
          out_rows = []
          for idx, kw in enumerate(KEYWORDS):
              # 连续两次限流就整体收工，不再硬耗
              if STATE["quota"] >= 2:
                  say("连续限流，提前终止（已完成 %d/%d 个词）" % (idx, len(KEYWORDS)))
                  break
              if idx:
                  time.sleep(20 + random.uniform(0, 8))
              pts = curve(kw)
              if not pts:
                  say("FAIL %s" % kw)
                  continue
              by_day = {}
              for day, v in pts:
                  by_day[day] = max(by_day.get(day, 0), v)
              for day in sorted(by_day):
                  out_rows.append({"keyword": kw, "date": day,
                                   "peak": by_day[day], "points": len(pts)})
              say("OK %s: %d 天, 峰值 %d" % (kw, len(by_day), max(by_day.values())))

          if out_rows:
              fields = ["keyword", "date", "peak", "points"]
              for p in ("data/seed/latest.csv",
                        "data/seed/%s.csv" % datetime.now(BJ).strftime("%Y-%m-%d")):
                  with open(p, "w", newline="", encoding="utf-8") as f:
                      w = csv.DictWriter(f, fieldnames=fields)
                      w.writeheader()
                      w.writerows(out_rows)
                  say("写出 %s (%d 行)" % (p, len(out_rows)))
          else:
              say("种子词全部失败，未写出")

          with open("data/seed/debug.log", "w", encoding="utf-8") as fh:
              fh.write("\n".join(LOG) + "\n")
          sys.exit(0 if out_rows else 1)
          PY

      - name: Commit and push
        shell: bash
        run: |
          git config user.name  "trends-bot"
          git config user.email "trends-bot@users.noreply.github.com"
          git add -A data/seed
          if git diff --cached --quiet; then
            echo "无变化，跳过提交"
          else
            git commit -m "seed: $(TZ=Asia/Shanghai date +%F) weekly snapshot"
            git push
          fi
